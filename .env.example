PORT=8080
DATABASE_URL=postgres://ptx:ptx@localhost:55432/ptx
REDIS_URL=redis://localhost:56379
VEXA_BASE_URL=http://localhost:18066   # real capture rig gateway; mock: http://localhost:18056
VEXA_API_KEY=vxa_change_me
# vexa | tinfoil
TRANSCRIPTION_PROVIDER=vexa
TINFOIL_BASE_URL=https://inference.tinfoil.sh
TINFOIL_API_KEY=
TINFOIL_MODEL=voxtral-small-24b
# turns (per speaker turn, default) | whole (one call, one segment)
TINFOIL_SEGMENTATION=turns
# worker tuning (ms)
VEXA_POLL_INTERVAL_MS=5000
# Per-meeting remote-participant audio silence window before Vexa completes the bot as left_alone (milliseconds).
VEXA_MAX_TIME_LEFT_ALONE_MS=300000

# Signal calls use a separate, loopback-only capture worker (Signal Desktop CDP + PulseAudio).
# A random 32-byte base64 or 64-character hex key encrypts call fragments at rest.
SIGNAL_CAPTURE_URL=http://127.0.0.1:18076
SIGNAL_CAPABILITY_KEY=
SIGNAL_MAX_CONCURRENT_CALLS=1
# Run `bun run signal-capture-worker` on the same host as a linked Signal Desktop profile.
# These endpoints/bindings must remain loopback-only. SIGNAL_TRANSCRIBER is an argv prefix; the
# worker appends a temporary wav path and expects JSON RawSegment[] on stdout.
SIGNAL_CAPTURE_BIND=127.0.0.1
SIGNAL_CAPTURE_PORT=18076
SIGNAL_CDP_URL=http://127.0.0.1:9222
SIGNAL_PULSE_SOURCE=
SIGNAL_TRANSCRIBER=
LOG_LEVEL=info
