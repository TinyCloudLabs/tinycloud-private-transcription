#!/bin/sh
set -eu

wav="$1"
response="$(curl --fail --silent --show-error -F "file=@${wav};type=audio/wav" -F model=local "${SIGNAL_WHISPER_URL:?SIGNAL_WHISPER_URL is required}")"
text="$(printf '%s' "$response" | jq -r '.text // empty')"
[ -n "$text" ] || exit 1
jq -n --arg text "$text" '[{start:0,end:0,text:$text}]'
