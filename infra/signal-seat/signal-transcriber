#!/bin/sh
set -eu

model="${SIGNAL_WHISPER_MODEL:-small.en}"

if [ "${1:-}" = "--check" ]; then
  curl --fail --silent --show-error --connect-timeout 2 --max-time 5 \
    "${SIGNAL_WHISPER_HEALTH_URL:?SIGNAL_WHISPER_HEALTH_URL is required}" >/dev/null
  marker="${XDG_RUNTIME_DIR:-/tmp}/ptx-signal-whisper-model-ready"
  if [ -r "$marker" ] && [ "$(sed -n '1p' "$marker")" = "$model" ]; then
    exit 0
  fi
  wav="$(mktemp /tmp/ptx-signal-whisper-check.XXXXXX.wav)"
  trap 'rm -f "$wav" "${marker}.next"' EXIT
  ffmpeg -loglevel error -f lavfi -i anullsrc=r=16000:cl=mono -t 0.25 -y "$wav"
  curl --fail --silent --show-error --connect-timeout 5 --max-time 300 -o /dev/null \
    -F "file=@${wav};type=audio/wav" -F "model=${model}" \
    "${SIGNAL_WHISPER_URL:?SIGNAL_WHISPER_URL is required}"
  printf '%s\n' "$model" > "${marker}.next"
  mv "${marker}.next" "$marker"
  exit 0
fi

wav="$1"
response="$(curl --fail --silent --show-error --connect-timeout 5 --max-time 300 -F "file=@${wav};type=audio/wav" -F "model=${model}" "${SIGNAL_WHISPER_URL:?SIGNAL_WHISPER_URL is required}")"
text="$(printf '%s' "$response" | jq -r '.text // empty')"
[ -n "$text" ] || exit 1
jq -n --arg text "$text" '[{start:0,end:0,text:$text}]'
