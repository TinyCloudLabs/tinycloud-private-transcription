# Compose interpolation env for the pinned upstream Vexa stack (infra/vexa/upstream/deploy/compose).
# Dev-only defaults; no real secrets. Passed via `docker compose --env-file infra/vexa/vexa.env`.
COMPOSE_PROJECT_NAME=vexa-v012
# 18056 is upstream's default; the API branch runs its mock Vexa there, so the real gateway sits on 18066.
API_GATEWAY_HOST_PORT=18066
ADMIN_API_PORT=18057
MEETING_API_PORT=18080
RUNTIME_API_PORT=18090
AGENT_API_PORT=18100
MCP_HOST_PORT=18010
TERMINAL_PORT=13000
POSTGRES_HOST_PORT=5458
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001

# Published upstream images (never built here). See UPSTREAM_PIN for the source commit.
IMAGE_TAG=v012
# Our derived bot image = vexaai/vexa-bot:v012 + the dev CA in Chromium's NSS store (infra/vexa/bot).
BROWSER_IMAGE=ptx/vexa-bot:tc-devca
DOCKER_GID=0
LOG_LEVEL=info

DB_NAME=vexa
DB_USER=postgres
DB_PASSWORD=postgres
MINIO_ROOT_USER=vexa-access-key
MINIO_ROOT_PASSWORD=vexa-secret-key
MINIO_ACCESS_KEY=vexa-access-key
MINIO_SECRET_KEY=vexa-secret-key
MINIO_BUCKET=vexa
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false

ADMIN_TOKEN=dev-admin-token
INTERNAL_API_SECRET=vexa-internal-secret
DEFAULT_BOT_NAME=TinyCloud Notetaker
VEXA_DISPATCH_SIGNING_KEY=dev-dispatch-signing-key
NEXTAUTH_SECRET=dev-nextauth-secret

# CPU STT: faster-whisper-server (OpenAI-compatible /v1/audio/transcriptions) added by
# docker-compose.override.yml on the same compose network; the bot container resolves `whisper`.
TRANSCRIPTION_SERVICE_URL=http://whisper:8000
# faster-whisper-server ignores auth; a non-empty value is required for Vexa's "stt" capability (mode=all) to read configured + get probed.
TRANSCRIPTION_SERVICE_TOKEN=local-dev-stt
TRANSCRIPTION_MODEL=
WHISPER_MODEL=Systran/faster-whisper-small.en
TRANSCRIBE_ENABLED=true
RECORDING_ENABLED=true

# Self-hosted Jitsi hostnames the meeting-link parser must recognise (host contains "jitsi" anyway).
VEXA_JITSI_HOSTS=jitsi.local
GUARD_ENABLED=false
