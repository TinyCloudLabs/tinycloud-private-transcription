# docker-jitsi-meet env for the local capture-rig Jitsi. Anonymous rooms (no auth/JWT/lobby),
# TLS via our dev CA (infra/certs), reachable as https://jitsi.local:8443 from the host AND from
# the Vexa bot containers (the web/jvb services join the vexa compose network with that alias).
CONFIG=./cfg
HTTP_PORT=8001
HTTPS_PORT=8443
TZ=UTC
PUBLIC_URL=https://jitsi.local:8443
JITSI_IMAGE_VERSION=stable-11146-2

# JVB media: UDP 10000 published on the host; advertise the docker-host IPs for host-side clients.
JVB_PORT=10000
JVB_ADVERTISE_IPS=172.17.0.1
JVB_ADVERTISE_PRIVATE_CANDIDATES=1
ENABLE_LETSENCRYPT=0
DISABLE_HTTPS=0
ENABLE_HTTP_REDIRECT=1

# Anyone can create/join rooms; no lobby, no auth, no prejoin gating beyond the name field.
ENABLE_AUTH=0
ENABLE_GUESTS=1
ENABLE_LOBBY=0
ENABLE_PREJOIN_PAGE=1
ENABLE_WELCOME_PAGE=1
ENABLE_XMPP_WEBSOCKET=1
ENABLE_P2P=0
ENABLE_RECORDING=0
ENABLE_TRANSCRIPTIONS=0
START_WITH_VIDEO_MUTED=1
ENABLE_NOISY_MIC_DETECTION=0
ENABLE_TALK_WHILE_MUTED=0

XMPP_DOMAIN=meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
JVB_BREWERY_MUC=jvbbrewery
JVB_AUTH_USER=jvb
JICOFO_AUTH_USER=focus

# Dev-only component passwords (docker-jitsi-meet refuses to start without them).
JICOFO_AUTH_PASSWORD=ptxdevjicofo1
JVB_AUTH_PASSWORD=ptxdevjvb1
JIGASI_XMPP_PASSWORD=ptxdevjigasi1
JIGASI_TRANSCRIBER_PASSWORD=ptxdevjigasitx1
JIBRI_RECORDER_PASSWORD=ptxdevjibrirec1
JIBRI_XMPP_PASSWORD=ptxdevjibri1
