# Sealed env for ptx-batch (phala deploy -e <file>). The deploy workflow writes this from the `ptx-batch`
# GitHub Environment secrets; never commit real values.
POSTGRES_PASSWORD=change_me
# The owner's dedicated batch Tinfoil key. Empty = the service answers 503 service_unavailable to every create.
BATCH_TINFOIL_API_KEY=
# One line of JSON [{"id","project","scopes","sha256"}] from scripts/mint-bootstrap-keys.ts (hashes only).
PTX_BOOTSTRAP_KEYS=
# BATCH_CORS_ORIGINS (not a secret, and not yet passed through app-compose.yaml; wiring it is a deploy change):
# comma-separated browser origins allowed to PUT /uploads/{id} directly; an entry may start with one "*." label.
# Empty/unset = no CORS headers. A malformed entry stops the service at startup. Recommended value:
#   https://tinycloud.chat,https://*.tinychat-4jq.pages.dev,tauri://localhost,http://tauri.localhost,capacitor://localhost,https://localhost
# BATCH_DIARIZATION_ENABLED is not a secret: app-compose.yaml sets it to "true" on both the api and upload-worker
# services (speaker diarization with the sherpa-onnx install baked into the image; docs/diarization-benchmark.md).
