# Encrypted env for `phala deploy -e infra/dstack/.env` (copy to infra/dstack/.env; gitignored). No defaults here are secrets.
PTX_IMAGE=ghcr.io/tinycloudlabs/tinycloud-private-transcription/api:v1
VEXA_IMAGE_TAG=v012
VEXA_MAX_TIME_LEFT_ALONE_MS=300000
POSTGRES_PASSWORD=change-me
VEXA_DB_PASSWORD=change-me
VEXA_ADMIN_TOKEN=change-me
VEXA_INTERNAL_API_SECRET=change-me
MINIO_ROOT_USER=vexa-access-key
MINIO_ROOT_PASSWORD=change-me
TRANSCRIPTION_PROVIDER=vexa
TINFOIL_API_KEY=
TINFOIL_MODEL=voxtral-small-24b
WHISPER_MODEL=Systran/faster-whisper-small.en

# Recovery rollout fields. Switches remain off and unresolved operator values stay blank.
# The PTX_IMAGE tag above is legacy-only while every recovery switch is false. A recovery-capable
# rollout must replace it with name@sha256:<64 lowercase hex>, never a mutable tag.
# When copying this file for a recovery-off deployment, delete/omit every blank RECOVERY_* entry;
# passing any blank entry as an empty string intentionally stops startup. Alternatively, supply
# every operator-approved recovery value.
RECOVERY_V2_ENABLED=false
RECOVERY_PROVIDER_ENABLED=false
RECOVERY_FINALIZER_ENABLED=false
RECOVERY_VEXA_FALLBACK_ENABLED=false
RECOVERY_SEGMENTATION_MODE=
RECOVERY_MANUAL_CYCLES_PER_MEETING=
RECOVERY_COOLDOWN_BASE_MS=
RECOVERY_COOLDOWN_MAX_MS=
RECOVERY_MAX_SOURCE_DURATION_MS=
RECOVERY_MAX_SOURCE_PCM_BYTES=
RECOVERY_MAX_RECORDING_BYTES=
RECOVERY_PROVIDER_MAX_CHUNK_DURATION_MS=
RECOVERY_PROVIDER_MAX_WAV_BYTES=
RECOVERY_MAX_CHUNK_DURATION_MS=
RECOVERY_MAX_WAV_BYTES=
RECOVERY_MAX_CALLS_PER_OPERATION=
RECOVERY_MAX_SUBMITTED_AUDIO_MS_PER_OPERATION=
RECOVERY_MAX_COST_MICROUNITS_PER_OPERATION=
RECOVERY_MAX_CONCURRENT_PROVIDER_CALLS=
RECOVERY_OPERATION_DEADLINE_MS=
RECOVERY_DELAYED_THRESHOLD_MS=
RECOVERY_SPLIT_FLOOR_MS=
RECOVERY_RETRY_BASE_MS=
RECOVERY_MAX_RETRY_AFTER_MS=
RECOVERY_PROJECT_MANUAL_CYCLES=
RECOVERY_PROJECT_AUTOMATIC_CYCLES=
RECOVERY_PROJECT_MAX_CALLS=
RECOVERY_PROJECT_MAX_SUBMITTED_AUDIO_MS=
RECOVERY_PROJECT_MAX_COST_MICROUNITS=
RECOVERY_PLAN_MAX_CHUNKS=
