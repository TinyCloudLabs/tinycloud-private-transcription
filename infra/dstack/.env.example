# Encrypted env for `phala deploy -e infra/dstack/.env` (copy to infra/dstack/.env; gitignored). No defaults here are secrets.
PTX_IMAGE=ghcr.io/tinycloudlabs/tinycloud-private-transcription/api:v1
# Must match the commit-addressed, digest-pinned default in app-compose.yaml.
PTX_BOT_IMAGE=ghcr.io/tinycloudlabs/vexa/bot:tc-e49f3f3@sha256:578f38ae8d0791b11cd1b7bde98484de95181912d72051a7860edcc1f31b4000
# Used only by unchanged upstream admin/runtime/agent components.
VEXA_IMAGE_TAG=v012
VEXA_MAX_TIME_LEFT_ALONE_MS=300000
POSTGRES_PASSWORD=change-me
VEXA_DB_PASSWORD=change-me
VEXA_ADMIN_TOKEN=change-me
VEXA_INTERNAL_API_SECRET=change-me
MINIO_ROOT_USER=vexa-access-key
MINIO_ROOT_PASSWORD=change-me
TRANSCRIPTION_PROVIDER=vexa
WHISPER_MODEL=Systran/faster-whisper-small.en
# One persistent Signal Desktop seat. Generate SIGNAL_CAPABILITY_KEY independently; it encrypts
# incoming Signal URL fragments at rest and must never be logged or placed in a compose file.
SIGNAL_CAPTURE_IMAGE=ghcr.io/tinycloudlabs/tinycloud-private-transcription/signal-seat:v1
SIGNAL_CAPABILITY_KEY=
SIGNAL_PULSE_SOURCE=ptx_sink.monitor
