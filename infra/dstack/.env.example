# Encrypted env for `phala deploy -e infra/dstack/.env` (copy to infra/dstack/.env; gitignored). No defaults here are secrets.
# Production API/worker and Signal-seat image references are immutable pins in app-compose.yaml,
# not environment overrides. This prevents stale sealed env from silently selecting old code.
# The Vexa bot may still be selected explicitly and must remain digest-pinned.
PTX_BOT_IMAGE=ghcr.io/tinycloudlabs/vexa/bot:tc-e5482a8@sha256:3331c4ea30fa52c2070d5dc9e2887070df0c1ed17fa4be4cbb03e15afdd09ff9
# Optional whole-reference overrides for unchanged upstream components. Keep them digest-pinned.
VEXA_ADMIN_IMAGE=vexaai/v012-admin-api:v012@sha256:4c702354384eafe3a933cd537a106b7c15067cfd368a5f6da1a6e675e7e03e04
VEXA_RUNTIME_IMAGE=vexaai/v012-runtime:v012@sha256:a1f6448fbb380b9433364e8b572ec25a12aa4f274bf403f1d83a89cbf5812f2d
VEXA_AGENT_IMAGE=vexaai/v012-agent-api:v012@sha256:6eb37574b33aab233aabbe5907e06e106bae44a403e5df781a436da8201a928d
VEXA_AGENT_WORKER_IMAGE=vexaai/v012-agent-worker:v012@sha256:a1120b24765ff6b1c86c5f9ddee35b5e71fdbb9543a23b918b278373ad705022
VEXA_MAX_TIME_LEFT_ALONE_MS=300000
POSTGRES_PASSWORD=change-me
VEXA_DB_PASSWORD=change-me
VEXA_ADMIN_TOKEN=change-me
VEXA_INTERNAL_API_SECRET=change-me
MINIO_ROOT_USER=vexa-access-key
MINIO_ROOT_PASSWORD=change-me
# PTX compatibility label only; Vexa remains the primary provider.
TRANSCRIPTION_PROVIDER=vexa
TINFOIL_BASE_URL=https://inference.tinfoil.sh
TINFOIL_API_KEY=
TINFOIL_MODEL=voxtral-small-24b
WHISPER_MODEL=Systran/faster-whisper-small.en
# Three persistent Signal Desktop seats. The CVM self-provisions their private control tokens and
# one durable capability key; do not set or log those values through the deployment environment.
SIGNAL_PULSE_SOURCE=ptx_sink.monitor
